{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Permissions for the settings window (opening the log folder, external links, file dialogs, autostart toggle, updater).",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "os:default",
    "dialog:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "store:default",
    "updater:default"
  ]
}
