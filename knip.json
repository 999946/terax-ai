{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@size-limit/file",
        "tailwindcss",
        "tw-animate-css",
        "shadcn",
        "@codemirror/autocomplete",
        "@uiw/codemirror-themes",
        "@fontsource/jetbrains-mono"
      ]
    },
    "packages/ghostty-core": {
      "entry": [
        "lib/core.ts",
        "lib/protocol.ts",
        "lib/adapted/index.ts",
        "lib/official/index.ts"
      ],
      "project": ["lib/**/*.{ts,tsx}"]
    }
  }
}